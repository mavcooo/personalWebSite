# URL della tua API (usare il prefisso VITE_ per esporre la variabile al client)
VITE_API_URL=https://api.example.com

# Modalità (development/production)
NODE_ENV=development

# Database (development defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=personaldb
DB_USER=devuser
DB_PASSWORD=devpass
MYSQL_ROOT_PASSWORD=rootpass
